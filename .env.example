# Required in every environment (development and production). Encrypts the
# HttpOnly session cookie that carries your CloudInverter credentials between
# requests. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Optional. How often the server may call CloudInverter for a signed-in
# session. CloudInverter itself refreshes roughly every 5 minutes.
POLL_INTERVAL_MS=30000
